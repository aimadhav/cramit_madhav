# Runtime variables required by the mobile app.
# Configure these in EAS Environment Variables for cloud builds.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# Public legal/support pages. Defaults point to this repository's GitHub Pages site.
EXPO_PUBLIC_PRIVACY_URL=https://aimadhav.github.io/cramit_madhav/privacy.html
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://aimadhav.github.io/cramit_madhav/delete-account.html
EXPO_PUBLIC_SUPPORT_URL=https://aimadhav.github.io/cramit_madhav/support.html

# Sentry build metadata and source-map upload credentials.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Never put SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, or DIRECT_URL in the app build.
