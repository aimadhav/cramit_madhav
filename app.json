{
  "expo": {
    "name": "Cramit",
    "slug": "madhavjoshi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cramit",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07090d",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cramit.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.cramit.app",
      "versionCode": 1
    },
    "androidNavigationBar": {
      "backgroundColor": "#0b0c0e",
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#0b0c0e",
          "barStyle": "light",
          "borderColor": "#2a2c32",
          "visibility": "visible",
          "behavior": "inset-swipe",
          "position": "relative"
        }
      ]
    ],
    "web": {
      "output": "server"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "41905ad8-2918-49e2-ad5b-19084e6a1a84"
      }
    },
    "owner": "madhavcramits-team"
  }
}
